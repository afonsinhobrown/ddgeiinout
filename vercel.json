{
  "version": 2,
  "builds": [
    {
      "src": "gestao_stae/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/gestao_stae/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "gestao_stae/app.py"
    }
  ],
  "env": {
    "CLOUD_MODE": "true"
  }
}
